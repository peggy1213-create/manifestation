# Copy to apps/web/.env.local for local runs, and set the same value in CI for
# `pnpm build`. It is baked into the build, because sitemap.xml, the RSS feed and
# the Open Graph image URLs are generated statically and need an absolute origin.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Set to 1 to include articles marked `draft: true` in a production build, for
# review. Leave unset for real deploys — drafts are hidden in production.
SHOW_DRAFTS=
